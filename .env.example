# ก็อปไฟล์นี้เป็น .env แล้วใส่ค่าจริงของตัวเอง — ห้าม commit .env ตัวจริงเด็ดขาด (.gitignore กันไว้แล้ว)

# Database — Postgres connection string
# ตอนนี้: ยังใช้ Supabase pooler อยู่ (พอร์ต 6543, transaction mode — ต้องมี ?pgbouncer=true หรือใช้ prepare:false ใน db.ts)
# หลังย้ายไป Neon: เปลี่ยนมาใช้ connection string จาก Neon dashboard แทน (รูปแบบ postgres:// เดียวกัน ไม่ต้องแก้โค้ด)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ใช้เซ็น/ตรวจสอบ JWT token ตอน login — สุ่มด้วย `openssl rand -base64 32` เอง อย่าใช้ค่าตัวอย่างจริง
JWT_SECRET=

# secret สำหรับยืนยันตัวตนตอนเรียก POST /internal/cleanup/expired-order-files (cron job ภายนอกเรียกพร้อม header x-cleanup-secret)
CLEANUP_SECRET=

PORT=4000

# --- Cloudflare R2 (เก็บไฟล์อัปโหลด — สลิปโอนเงิน, ไฟล์งานพิมพ์, รูปร้าน, บัตรประชาชน) ---
# สร้างที่ Cloudflare dashboard > R2 > Manage R2 API Tokens (permission: Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL สาธารณะสำหรับ bucket "shop-photos" (bucket เดียวที่ public:true ใน apps/api/src/storage.ts)
# ตั้งค่าที่ bucket นั้น > Settings > Public access > เปิด custom domain หรือใช้ *.r2.dev subdomain ที่ได้มา
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev
